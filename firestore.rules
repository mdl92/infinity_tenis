rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Usuarios: solo el admin da de alta (no hay registro). Los nombres son públicos (clasificaciones) ----
    match /users/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Estructura del torneo: pública para leer, solo el admin escribe ----
    match /tournaments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /groups/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Parejas de dobles: públicas para leer, solo el admin las forma ----
    match /teams/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Partidos ----
    // En dobles, player1Id/player2Id son parejas y el partido guarda quién juega en cada lado:
    // team1Ids (lado de player1Id), team2Ids y memberIds (los cuatro).
    match /matches/{id} {
      // Personas del mismo lado que `uid` (en individuales, solo esa persona)
      function sideOf(d, uid) {
        return d.get('team1Ids', null) != null && uid in d.team1Ids ? d.team1Ids
          : d.get('team2Ids', null) != null && uid in d.team2Ids ? d.team2Ids
          : [uid];
      }
      function isParticipant() {
        return request.auth.uid in [resource.data.player1Id, resource.data.player2Id]
          || request.auth.uid in resource.data.get('memberIds', []);
      }
      // Quien confirma o rechaza tiene que ser del otro lado (la otra pareja, en dobles)
      function isRival() {
        return !(request.auth.uid in sideOf(resource.data, resource.data.reportedBy));
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // Un jugador del partido introduce el resultado
      function isReport() {
        return resource.data.status == 'pending'
          && request.resource.data.status == 'reported'
          && request.resource.data.reportedBy == request.auth.uid
          && request.resource.data.winnerId in [resource.data.player1Id, resource.data.player2Id]
          && changed().hasOnly(['sets', 'status', 'reportedBy', 'winnerId', 'disputedBy', 'disputedSets', 'updatedAt']);
      }
      // El contrincante lo confirma (sin poder tocar el marcador)
      function isConfirm() {
        return resource.data.status == 'reported'
          && isRival()
          && request.resource.data.status == 'confirmed'
          && request.resource.data.confirmedBy == request.auth.uid
          && changed().hasOnly(['status', 'confirmedBy', 'updatedAt']);
      }
      // ...o lo rechaza: vuelve a pendiente y queda constancia de la discrepancia
      function isReject() {
        return resource.data.status == 'reported'
          && isRival()
          && request.resource.data.status == 'pending'
          && request.resource.data.disputedBy == request.auth.uid
          && changed().hasOnly(['sets', 'status', 'reportedBy', 'winnerId', 'disputedBy', 'disputedSets', 'updatedAt']);
      }

      // Eliminatoria: al confirmarse un partido, cualquiera con sesión puede crear el de la ronda siguiente,
      // pero solo con su ID fijo (ko_<categoría>_<ronda>_<posición>), vacío y con los dos ganadores
      // confirmados de los partidos anteriores (ronda - 1, posiciones 2·pos y 2·pos + 1).
      // En dobles, las personas de la pareja que ganó el partido `f` (null en individuales)
      function winnerTeam(f) {
        return f.get('team1Ids', null) == null && f.get('team2Ids', null) == null ? null
          : f.winnerId == f.player1Id ? f.get('team1Ids', null) : f.get('team2Ids', null);
      }
      function koId(cat, round, slot) {
        return 'ko_' + cat + '_' + string(round) + '_' + string(slot);
      }
      function isAdvance(matchId) {
        let d = request.resource.data;
        let f1 = get(/databases/$(database)/documents/matches/$(koId(d.categoryId, d.round - 1, d.slot * 2))).data;
        let f2 = get(/databases/$(database)/documents/matches/$(koId(d.categoryId, d.round - 1, d.slot * 2 + 1))).data;
        return signedIn()
          && d.keys().hasOnly(['tournamentId', 'categoryId', 'groupId', 'round', 'slot', 'rounds', 'player1Id', 'player2Id',
                               'status', 'sets', 'winnerId', 'reportedBy', 'confirmedBy', 'createdAt',
                               'team1Ids', 'team2Ids', 'memberIds'])
          && d.round is int && d.slot is int && d.round > 0 && d.round < d.rounds
          && matchId == koId(d.categoryId, d.round, d.slot)
          && f1.status == 'confirmed' && f2.status == 'confirmed'
          && d.player1Id == f1.winnerId && d.player2Id == f2.winnerId
          && d.get('team1Ids', null) == winnerTeam(f1) && d.get('team2Ids', null) == winnerTeam(f2)
          && (winnerTeam(f1) == null || d.memberIds == winnerTeam(f1).concat(winnerTeam(f2)))
          && d.tournamentId == f1.tournamentId && d.categoryId == f1.categoryId && d.rounds == f1.rounds
          && d.groupId == null && d.status == 'pending' && d.sets.size() == 0
          && d.winnerId == null && d.reportedBy == null && d.confirmedBy == null;
      }

      allow read: if true;
      allow create: if isAdmin() || isAdvance(id);
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && isParticipant() && (isReport() || isConfirm() || isReject()));
    }
  }
}
